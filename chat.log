### Created /tmp/opencode/roundtrip.py
```python
import asyncio, sys, subprocess, tempfile, os
sys.path.insert(0, "/mnt/data/chatbot_model_4_31B-it")
from src.tts.synthesizer import VoiceSynthesizer
from src.stt.faster_whisper_transcriber import transcribe_audio

TESTS = [
    ("am-ET", "አመሰግናለሁ"),
    ("am-ET", "ሰላም ልጅህ እንዴት ነህ?"),
    ("en-US", "Hello, how are you today?"),
]

async def main():
    tts = VoiceSynthesizer()
    for lang, text in TESTS:
        mp3 = f"/tmp/opencode/rt_{len(text)}.mp3"
        await tts.generate_audio_file(text, mp3, lang=lang)
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as t:
            wav = t.name
        subprocess.run(["ffmpeg","-y","-i",mp3,"-ar","16000","-ac","1","-f","wav",wav],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        pcm = open(wav,"rb").read()[44:]
        result = transcribe_audio(pcm, sample_rate=16000)
        print(f"ORIGINAL : {text}")
        print(f"TRANSCRIBED: {result!r}")
        print(f"MATCH: {'YES' if text.lower() in result.lower() or result.lower() in text.lower() else 'NO'}")
        print("-" * 60)
        os.unlink(wav); os.unlink(mp3)

asyncio.run(main())
```

